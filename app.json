{
  "expo": {
    "name": "Atlas Supply",
    "slug": "sharkship-atlassupply",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/atlas-app.png",
    "scheme": "sharkshipatlassupply",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/atlas-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C6E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sharkship.atlassupply"
    },
    "android": {
      "package": "com.sharkship.atlassupply",
      "newArchEnabled": true,
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1A3C6E",
        "foregroundImage": "./assets/images/atlas-app.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ea935923-ea57-4020-a106-cd654a1688ee"
      }
    },
    "owner": "ankitsharkshipdevs-organization",
    "updates": {
      "url": "https://u.expo.dev/ea935923-ea57-4020-a106-cd654a1688ee",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.2"
  }
}
